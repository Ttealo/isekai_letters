{
  "version": "0.23.2",
  "name": "이세계 편지",
  "identifier": "isekai_mailbox",
  "author": "Ttealo",
  "github": "https://github.com/Ttealo/isekai_letters",
  "description": "다른 세계의 누군가와 편지만 주고받아요. 편지는 진짜 시간을 들여 건너가고, 그쪽 시간은 다른 빠르기로 흘러요.",
  "permissions": [
    "generation",
    "personas",
    "ui_panels",
    "characters",
    "world_books",
    "image_gen",
    "images",
    "app_manipulation",
    "push_notification"
  ],
  "entry_backend": "dist/backend.js",
  "entry_frontend": "dist/frontend.js",
  "minimum_lumiverse_version": "1.2.4",
  "homepage": "https://github.com/Ttealo/isekai_letters"
}
